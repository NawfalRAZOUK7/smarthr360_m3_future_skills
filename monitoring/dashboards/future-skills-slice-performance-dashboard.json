{
  "dashboard": {
    "title": "Future Skills Slice Performance",
    "tags": ["smarthr360", "future-skills", "ml"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "5m",
    "panels": [
      {
        "id": 1,
        "title": "Macro F1 by Department (Top 10)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "topk(10, future_skills_slice_performance{slice_type=\"by_department\", metric=\"macro_f1\"})",
            "legendFormat": "{{slice_value}}"
          }
        ]
      },
      {
