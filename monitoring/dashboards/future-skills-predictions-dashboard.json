{
  "dashboard": {
    "title": "Future Skills Predictions",
    "tags": ["smarthr360", "future-skills", "ml"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "1m",
    "panels": [
      {
        "id": 1,
        "title": "Prediction Volume (rate)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(future_skills_predictions_total[5m])) by (engine, level)",
            "legendFormat": "{{engine}}/{{level}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "Abstain / Fallback Rate",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(future_skills_abstain_total[5m])) / sum(rate(future_skills_predictions_total[5m]))",
            "legendFormat": "abstain_rate"
          }
        ]
      },
      {
        "id": 3,
        "title": "Confidence (P50/P90)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.5, sum(rate(future_skills_prediction_confidence_bucket[5m])) by (le))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.9, sum(rate(future_skills_prediction_confidence_bucket[5m])) by (le))",
            "legendFormat": "p90"
          }
        ]
      },
      {
        "id": 4,
        "title": "Data Quality Flags",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "sum(rate(future_skills_data_quality_total[5m])) by (flag)",
            "legendFormat": "{{flag}}"
          }
        ]
      }
    ]
  }
}
