# Prediction Skills - Env Template (minimal essentials)
# Copy to .env and fill placeholders. See .env.example for full options.

SECRET_KEY=__APP_SECRET_KEY__
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (uncomment to use Postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/smarthr360

# CORS / CSRF (adjust to your frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External Auth (consumes tokens from auth service)
AUTH_LOCAL_ENABLED=False
AUTH_JWT_SHARED_SECRET=__AUTH_SECRET_KEY__          # use the SECRET_KEY from auth (HS256)
AUTH_ISSUER=smarthr360
AUTH_JWT_ALGORITHMS=HS256
AUTH_USERINFO_URL=http://127.0.0.1:8000/api/auth/me/

# ML toggle
FUTURE_SKILLS_USE_ML=True
